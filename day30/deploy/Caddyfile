# HTTPS с сертификатом Let's Encrypt, который Caddy получает и продлевает сам.
# Домен sslip.io резолвится в IP из своего имени, поэтому своя DNS-запись не нужна.
__DOMAIN__ {
	reverse_proxy 127.0.0.1:8310
}

# Сайты других сервисов на этом же VPS (например, редактор постов из day35 Hard).
import /etc/caddy/sites/*.caddy
