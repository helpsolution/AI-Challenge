# Скопируйте в .env и подставьте свой ключ.

# Единственный провайдер этого дня. Ключ: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Необязательно:
# AGENT_WINDOW_SIZE=4      # главный параметр дня: сколько последних сообщений уходит модели.
#                          # Больше — стратегии перестают различаться; меньше — агент
#                          # начинает переспрашивать уже к середине сценария
# AGENT_STRATEGY=SLIDING_WINDOW
# AGENT_TEMPERATURE=0.3
# AGENT_MODEL=deepseek-chat
# AGENT_CONTEXT_LIMIT=1000000
# PORT=8089
# DB_PATH=./data/day10.db
