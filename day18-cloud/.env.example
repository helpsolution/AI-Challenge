# Один и тот же файл годится и для локального запуска, и для сервера:
# deploy/deploy.sh кладёт его на VPS в /etc/habr-digest/habr-digest.env с правами 600.

# Ключ DeepSeek из https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Твой chat id: бот отвечает только ему. Пока не задан, бот на /start присылает этот id и больше ничего не делает
# TELEGRAM_CHAT_ID=

# Как часто бот сам присылает сводку, в минутах (1..1440). Для демо удобно 2–5
DIGEST_EVERY_MINUTES=120

# Токен между ботом и MCP-сервером: openssl rand -hex 32. Без него /mcp отвечает без проверки
# MCP_AUTH_TOKEN=

# Необязательные параметры
# NEWS_EVERY=15m               как часто забирать ленту Хабра
# NEWS_RETENTION=30d           сколько хранить статьи
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# MCP_URL=http://localhost:8192/mcp
