# Скопируйте в .env и подставьте свои ключи.

# Штатный провайдер проекта и стенд этого дня: контекст большой, лимит не мешает,
# поэтому сравнение получается про качество и деньги, а не про аварию.
# Ключ: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Нужен для второго опыта дня: модель с маленьким контекстом, на которой прогон без сжатия
# упирается в лимит, а прогон со сжатием продолжает разговор. Ключ: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Два прогона эксперимента — две базы. Один и тот же скрипт вопросов, разные режимы:
#   AGENT_CONTEXT_MODE=RAW     DB_PATH=./data/day9-raw.db      ./gradlew bootRun
#   AGENT_CONTEXT_MODE=SUMMARY DB_PATH=./data/day9-summary.db  ./gradlew bootRun

# Необязательно:
# AGENT_CONTEXT_MODE=SUMMARY         # или RAW — вся переписка уходит дословно
# AGENT_SUMMARY_MODEL=               # пусто — сворачиваем той же моделью, что отвечает
# LLM_PROVIDER=DEEPSEEK              # или OPENROUTER — меняется вместе с моделью и лимитом
# AGENT_MODEL=deepseek-chat
# AGENT_CONTEXT_LIMIT=1000000        # у openai/gpt-3.5-turbo-0613 — 4095
# OPENROUTER_CONTEXT_COMPRESSION=false   # true — историю урежет сам агрегатор, молча
# PORT=8088
# DB_PATH=./data/day9-summary.db
