# Ключ DeepSeek из https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Как часто агент сам выдаёт сводку, в минутах (1..1440). Для демо удобно 2–5
DIGEST_EVERY_MINUTES=30

# Токен MCP-сервера. Для docker compose обязателен: openssl rand -hex 32
# MCP_AUTH_TOKEN=

# Необязательные параметры
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# MCP_URL=http://localhost:8182/mcp
