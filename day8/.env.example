# Скопируйте в .env и подставьте свои ключи.

# Провайдер этого дня по умолчанию — OpenRouter: нужна модель с маленьким контекстом,
# чтобы упереться в лимит руками. Ключ: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Штатный провайдер проекта, дни 1–7. Ключ: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Необязательно:
# LLM_PROVIDER=OPENROUTER            # или DEEPSEEK — меняется вместе с моделью и лимитом
# AGENT_MODEL=openai/gpt-3.5-turbo-0613
# AGENT_CONTEXT_LIMIT=4095           # у моделей DeepSeek — 1000000
# OPENROUTER_CONTEXT_COMPRESSION=false   # true — историю урежут молча, без ошибки
# PORT=8087
# DB_PATH=./data/day8.db
