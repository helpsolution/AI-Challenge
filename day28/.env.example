# Ключ нужен только для облачной колонки сравнения. Без него RAG работает полностью локально.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODELS=qwen3.5:9b,llama3.2:3b
RERANKER_BASE_URL=http://127.0.0.1:8012
QUERY_REWRITE_ENABLED=true
RERANKER_TIMEOUT=120s
RETRIEVAL_CANDIDATE_K=20
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_RERANK_SCORE=0.0
PORT=8290
