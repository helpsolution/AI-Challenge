# Один и тот же файл годится и для локального запуска, и для сервера:
# deploy/deploy.sh кладёт его на VPS в /etc/habr-pipeline/habr-pipeline.env с правами 600.

# Ключ DeepSeek из https://platform.deepseek.com/api_keys.
# Нужен двоим: habr-service пишет им сводку (шаг summarize), бот — ведёт агента.
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Токен бота от @BotFather. Один токен — один работающий бот: если тот же токен опрашивает
# ещё какой-то процесс, Telegram отвечает 409 Conflict.
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Твой chat id: бот отвечает только ему. Пока не задан, бот на /start присылает этот id и больше ничего не делает
# TELEGRAM_CHAT_ID=

# Токен между ботом и MCP-сервером: openssl rand -hex 32. Без него /mcp отвечает без проверки
# MCP_AUTH_TOKEN=

# Необязательные параметры
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# MCP_URL=http://localhost:8202/mcp
